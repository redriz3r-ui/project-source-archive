{
  "name": "history-documentary-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Manifest-driven history documentary video engine built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HistoryDocumentary out/demo.mp4",
    "render:still": "remotion still src/index.ts HistoryDocumentary out/demo-frame.png --frame=180",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/core.test.ts && node --import tsx tests/intelligence.test.ts && node --import tsx tests/presidential.test.ts && node --import tsx tests/local-documentary.test.ts",
    "phone-proof": "node --import tsx cli/phone-proof.ts",
    "intelligence-proof": "node --import tsx cli/intelligence-proof.ts",
    "manila-research": "node --import tsx cli/manila-research.ts",
    "manila-assets": "node --import tsx cli/manila-assets.ts",
    "manila-script": "node --import tsx cli/manila-script.ts",
    "manila-opening": "node --import tsx cli/manila-opening.ts",
    "manila-documents": "node --import tsx cli/manila-documents.ts",
    "manila-audio": "node --import tsx cli/manila-audio.ts",
    "manila-full": "node --import tsx cli/manila-full.ts",
    "wiki-compile": "node --import tsx cli/wiki-compile.ts",
    "wiki-proof-assets": "node --import tsx cli/wiki-proof-assets.ts",
    "wiki-proof-render": "node --import tsx cli/wiki-proof-render.ts",
    "wiki-full-render": "node --import tsx cli/wiki-full-render.ts",
    "wiki-visual-evidence": "node --import tsx cli/wiki-visual-evidence.ts",
    "aguinaldo-segment": "node --import tsx cli/aguinaldo-segment.ts",
    "quezon-segment": "node --import tsx cli/quezon-segment.ts",
    "quezon-repair-assets": "node --import tsx cli/repair-quezon-assets.ts",
    "presidential": "node --import tsx cli/presidential.ts",
    "president": "node --import tsx cli/presidential.ts",
    "render:grid-proof": "remotion render src/index.ts PresidentGridTransitionProof ../outputs/president-grid-transition-proof.mp4 --codec=h264",
    "render:magsaysay-stick-proof": "remotion render src/index.ts MagsaysayStickFigureProof ../outputs/magsaysay-stick-figure-proof.mp4 --codec=h264",
    "render:magsaysay-photo-pose": "remotion render src/index.ts MagsaysayPhotoPoseProof ../outputs/magsaysay-photo-to-stick-proof.mp4 --codec=h264",
    "render:magsaysay-illustrated": "remotion render src/index.ts MagsaysayIllustratedSegment ../outputs/ramon-magsaysay-illustrated-segment.mp4 --codec=h264",
    "render:magsaysay-blocking": "remotion render src/index.ts MagsaysayIllustratedSegment ../outputs/ramon-magsaysay-visual-blocking-test.mp4 --codec=h264",
    "render:illustrated-aguinaldo": "remotion render src/index.ts IllustratedPresident01 ../outputs/illustrated-president-tests/01-emilio-aguinaldo.mp4 --codec=h264",
    "render:illustrated-aquino": "remotion render src/index.ts IllustratedPresident11 ../outputs/illustrated-president-tests/11-corazon-aquino.mp4 --codec=h264",
    "render:illustrated-presidents": "node --import tsx cli/render-illustrated-presidents.ts",
    "master:assemble-illustrated": "node --import tsx cli/assemble-illustrated-master.ts",
    "master:announcements": "node --import tsx cli/master-announcements.ts",
    "master:assemble": "node --import tsx cli/master-assemble.ts",
    "documentary": "node --import tsx cli/index.ts",
    "validate:sample": "node --import tsx cli/index.ts validate public/projects/sample/manifest.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.516",
    "@remotion/google-fonts": "4.0.516",
    "@remotion/media": "4.0.516",
    "maplibre-gl": "^5.7.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.516",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
