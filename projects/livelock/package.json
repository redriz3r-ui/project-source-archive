{
  "name": "livelock",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:dev",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --simulator",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package": "npm run build && npm run build:dev && node scripts/package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:dev && npm run build:unconfigured && npm run test:e2e",
    "build:unconfigured": "node scripts/build.mjs --unconfigured",
    "check:live": "node scripts/check-live.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.19.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "tldts": "^7.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
