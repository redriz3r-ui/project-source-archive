    "@maplibre/maplibre-gl-inspect": "^1.9.0",
    "@turf/area": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/length": "^7.4.0",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.14.0",
    "pmtiles": "^4.5.0"
