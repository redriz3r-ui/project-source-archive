{
  "name": "genes-in-space-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:analysis": "node --experimental-strip-types scripts/verify_analysis.mjs",
    "test:distance": "node --experimental-strip-types scripts/verify_point_distance.mjs",
    "test:distance-cli": "node scripts/verify_point_distance_cli.mjs",
    "test:distance-parity": "node --experimental-strip-types scripts/verify_distance_parity.mjs",
    "test:distance-contract": "node --experimental-strip-types scripts/verify_point_distance_contract.mjs",
    "distance:cli": "node --experimental-strip-types scripts/point_distance_cli.mjs",
    "area:cli": "node --experimental-strip-types scripts/polygon_area_cli.mjs",
    "test:area-contract": "node --experimental-strip-types scripts/verify_polygon_area_contract.mjs",
    "research:distance": "node --experimental-strip-types scripts/nussear_cell_distance.mjs",
    "research:area": "node --experimental-strip-types scripts/fleckenstein_array_area.mjs",
    "research:joshua-area": "node --experimental-strip-types scripts/esque_cell_area.mjs",
    "research:discover": "python3 scripts/desert_tortoise_research.py",
    "research:intake": "node --experimental-strip-types scripts/research_intake.mjs",
    "test:research-intake": "node --experimental-strip-types scripts/verify_research_intake.mjs",
    "test:joshua-intake": "node --experimental-strip-types scripts/verify_joshua_tree_intake.mjs",
    "test:joshua-layer": "node --experimental-strip-types scripts/verify_joshua_tree_layer.mjs",
    "test:research-discovery": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/verify_desert_tortoise_research.py",
    "test:research-distance": "node --experimental-strip-types scripts/verify_nussear_cell_distance.mjs",
    "test:pmtiles": "node --experimental-strip-types scripts/verify_pmtiles.mjs",
    "test:study": "node --experimental-strip-types scripts/verify_study_metadata.mjs",
    "test:fleckenstein-layer": "node --experimental-strip-types scripts/verify_fleckenstein_layer.mjs",
    "test:research-area": "node --experimental-strip-types scripts/verify_fleckenstein_array_area.mjs",
    "preview": "vite preview --host 127.0.0.1"
